@model RaceDay_MVC.Models.RecordResultViewModel

@{
    ViewData["Title"] = "Record Result";
}

<div class="container mt-4">

    <h2>Record Result</h2>
    <h5>@ViewBag.EventName</h5>

    <form asp-action="RecordResult"
          asp-route-eventId="@ViewBag.EventId"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EnrollmentId" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finishing Time
            </label>

            <input asp-for="FinishTime"
                   class="form-control"
                   placeholder="00:35:20" />

            <small class="text-muted">
                Enter hours:minutes:seconds, for example 00:35:20.
            </small>

            <span asp-validation-for="FinishTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishingPosition" class="form-label">
                Finishing Position
            </label>

            <input asp-for="FinishingPosition"
                   type="number"
                   min="1"
                   class="form-control" />

            <span asp-validation-for="FinishingPosition"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-action="Enrolments"
           asp-route-eventId="@ViewBag.EventId"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>
