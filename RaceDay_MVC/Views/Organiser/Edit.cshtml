@model RaceDay_MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4" style="max-width:650px">

    <h2>Edit Event</h2>

    <form asp-action="Edit" asp-route-id="@Model.EventId" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate"
                   type="date"
                   value="@Model.EventDate.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventTypeId" class="form-label">
                Event Type
            </label>

            <select asp-for="EventTypeId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.EventTypes, "EventTypeId", "TypeName"))">
                <option value="">Select Event Type</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Update Event
        </button>

        <a asp-action="Events" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>