@model RaceDay_MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <h2>Edit Category</h2>

    <form asp-action="EditCategory"
          asp-route-id="@Model.CategoryId"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CategoryId" />
        <input type="hidden" asp-for="EventId" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">
                Category Name
            </label>
            <input asp-for="CategoryName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryType" class="form-label">
                Category Type
            </label>
            <select asp-for="CategoryType" class="form-select">
                <option value="AGE">Age</option>
                <option value="DISTANCE">Distance</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryValue" class="form-label">
                Category Value
            </label>
            <input asp-for="CategoryValue" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Update Category
        </button>

        <a asp-action="Categories"
           asp-route-eventId="@Model.EventId"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>