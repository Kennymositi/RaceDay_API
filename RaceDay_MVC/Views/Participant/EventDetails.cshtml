@model RaceDay_MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
    var categories = ViewBag.Categories as List<RaceDay_MVC.Models.CategoryViewModel>;
}

<div class="container mt-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    <h2>@Model.Name</h2>

    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy")</p>
    <p><strong>Location:</strong> @Model.Location</p>
    <p><strong>Distance:</strong> @Model.Distance km</p>

    <hr />

    <h4>Available Categories</h4>

    @if (categories == null || !categories.Any())
    {
        <div class="alert alert-info">
            No categories are currently available for this event.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var category in categories)
            {
                <div class="list-group-item">
                    <h5>@category.CategoryName</h5>

                    <p>@category.Description</p>

                    <p>
                        @category.CategoryType - @category.CategoryValue
                    </p>

                    <form asp-controller="Participant"
                          asp-action="Enrol"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="eventId"
                               value="@Model.EventId" />

                        <input type="hidden"
                               name="categoryId"
                               value="@category.CategoryId" />

                        <button type="submit"
                                class="btn btn-success">
                            Enrol Now
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Events"
       class="btn btn-secondary mt-3">
        Back to Events
    </a>
</div>