@model List<RaceDay_MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container mt-5">
    <h2>Upcoming RaceDay Events</h2>
    <p>Discover events and find your next challenge.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Location</td>
                            <td>@item.Distance</td>
                            <td>
                                <a asp-controller="Participant"
                                   asp-action="EventDetails"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>